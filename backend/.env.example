# Copy this file to ".env" (in this same folder) and fill it in. Restart the server afterwards.
# The ".env" file holds a secret: do not share it or put it in version control.

# --- Writing cards automatically with an AI service ("Fill automatically" in "My own cards") ---
# Without LLM_API_KEY the button is simply not shown.

# The secret key of the service. For Groq it starts with "gsk_".
LLM_API_KEY=

# Any service with an OpenAI-style chat API. Pick one pair:
# Groq (default):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Google Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# OpenRouter (free models end in ":free"):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Set to false if the service answers "response_format is not supported".
# LLM_JSON_MODE=true

# How long to wait for the service, in milliseconds.
# LLM_TIMEOUT_MS=30000
